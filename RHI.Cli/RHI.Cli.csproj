<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>RenoDXCommander.Cli</RootNamespace>
    <AssemblyName>rhictl</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RhiSourceDir Condition="'$(RhiSourceDir)' == ''">$(MSBuildThisFileDirectory)..\RenoDXCommander</RhiSourceDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RHI.Core\RHI.Core.csproj" />
  </ItemGroup>

  <!-- Files the service layer expects next to the executable (AppPaths uses the
       process folder). Copied from the app so the CLI behaves identically. -->
  <ItemGroup>
    <Content Include="$(RhiSourceDir)\7z.exe" Link="7z.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RhiSourceDir)\7z.dll" Link="7z.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RhiSourceDir)\ReShade.ini" Link="ReShade.ini" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RhiSourceDir)\ReShade.Vulkan.ini" Link="ReShade.Vulkan.ini" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(RhiSourceDir)\ReShade64.json" Link="ReShade64.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
